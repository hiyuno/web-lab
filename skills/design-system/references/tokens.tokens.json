{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Tokens base de web-lab en formato W3C DTCG. Tres capas: primitivos (color, spacing, text, font, radius, shadow, ease, duration, breakpoint), semantic (decisiones, con modo oscuro en $extensions.web-lab.dark) y component (solo cuando hace falta). Edita los valores, no la estructura.",
  "color": {
    "$type": "color",
    "gray":  { "50": {"$value": "oklch(98.5% 0.002 250)"}, "100": {"$value": "oklch(96.5% 0.003 250)"}, "200": {"$value": "oklch(92% 0.005 250)"}, "300": {"$value": "oklch(86% 0.007 250)"}, "400": {"$value": "oklch(70% 0.01 250)"}, "500": {"$value": "oklch(55% 0.012 250)"}, "600": {"$value": "oklch(45% 0.012 250)"}, "700": {"$value": "oklch(36% 0.012 250)"}, "800": {"$value": "oklch(26% 0.012 250)"}, "900": {"$value": "oklch(20% 0.012 250)"}, "950": {"$value": "oklch(14% 0.012 250)"} },
    "brand": { "50": {"$value": "oklch(97% 0.02 255)"}, "100": {"$value": "oklch(93% 0.05 255)"}, "200": {"$value": "oklch(86% 0.09 255)"}, "300": {"$value": "oklch(76% 0.13 255)"}, "400": {"$value": "oklch(66% 0.17 255)"}, "500": {"$value": "oklch(56% 0.2 255)"}, "600": {"$value": "oklch(48% 0.19 255)"}, "700": {"$value": "oklch(40% 0.16 255)"}, "800": {"$value": "oklch(33% 0.12 255)"}, "900": {"$value": "oklch(27% 0.09 255)"}, "950": {"$value": "oklch(20% 0.06 255)"} },
    "red":   { "500": {"$value": "oklch(58% 0.2 27)"}, "600": {"$value": "oklch(50% 0.19 27)"}, "300": {"$value": "oklch(78% 0.12 27)"} },
    "green": { "500": {"$value": "oklch(62% 0.16 150)"}, "600": {"$value": "oklch(50% 0.14 150)"}, "300": {"$value": "oklch(80% 0.12 150)"} },
    "amber": { "500": {"$value": "oklch(75% 0.16 75)"}, "700": {"$value": "oklch(52% 0.13 70)"}, "300": {"$value": "oklch(88% 0.12 85)"} },
    "white": {"$value": "#ffffff"},
    "black": {"$value": "#000000"}
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Base 4. Tailwind genera p-*, m-*, gap-* con estas claves.",
    "0": {"$value": "0px"}, "1": {"$value": "0.25rem"}, "2": {"$value": "0.5rem"}, "3": {"$value": "0.75rem"}, "4": {"$value": "1rem"}, "5": {"$value": "1.25rem"}, "6": {"$value": "1.5rem"}, "8": {"$value": "2rem"}, "10": {"$value": "2.5rem"}, "12": {"$value": "3rem"}, "16": {"$value": "4rem"}, "20": {"$value": "5rem"}, "24": {"$value": "6rem"}, "32": {"$value": "8rem"}
  },
  "text": {
    "$type": "dimension",
    "$description": "Escala tipográfica. Tailwind genera text-*.",
    "xs": {"$value": "0.75rem"}, "sm": {"$value": "0.875rem"}, "base": {"$value": "1rem"}, "lg": {"$value": "1.125rem"}, "xl": {"$value": "1.25rem"}, "2xl": {"$value": "1.5rem"}, "3xl": {"$value": "1.875rem"}, "4xl": {"$value": "2.25rem"}, "5xl": {"$value": "3rem"}, "6xl": {"$value": "3.75rem"}
  },
  "leading": { "$type": "number", "tight": {"$value": "1.2"}, "snug": {"$value": "1.35"}, "normal": {"$value": "1.5"}, "relaxed": {"$value": "1.65"} },
  "tracking": { "$type": "dimension", "tight": {"$value": "-0.02em"}, "normal": {"$value": "0em"}, "wide": {"$value": "0.04em"} },
  "font": {
    "$type": "fontFamily",
    "sans": {"$value": ["Inter", "system-ui", "sans-serif"]},
    "serif": {"$value": ["Source Serif 4", "Georgia", "serif"]},
    "mono": {"$value": ["JetBrains Mono", "ui-monospace", "monospace"]}
  },
  "radius": { "$type": "dimension", "none": {"$value": "0px"}, "sm": {"$value": "0.25rem"}, "md": {"$value": "0.5rem"}, "lg": {"$value": "0.75rem"}, "xl": {"$value": "1rem"}, "full": {"$value": "9999px"} },
  "shadow": {
    "$type": "shadow",
    "sm": {"$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)"},
    "md": {"$value": "0 4px 6px -1px rgb(0 0 0 / 0.08), 0 2px 4px -2px rgb(0 0 0 / 0.06)"},
    "lg": {"$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.08)"}
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {"$value": "cubic-bezier(0.16, 1, 0.3, 1)"},
    "in-out": {"$value": "cubic-bezier(0.65, 0, 0.35, 1)"},
    "spring": {"$value": "linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001)"}
  },
  "duration": { "$type": "duration", "fast": {"$value": "150ms"}, "normal": {"$value": "200ms"}, "slow": {"$value": "300ms"}, "page": {"$value": "400ms"} },
  "breakpoint": { "$type": "dimension", "sm": {"$value": "40rem"}, "md": {"$value": "48rem"}, "lg": {"$value": "64rem"}, "xl": {"$value": "80rem"} },

  "semantic": {
    "$description": "Decisiones. Solo alias a primitivos. Modo oscuro en $extensions.web-lab.dark.",
    "color": {
      "$type": "color",
      "background":          {"$value": "{color.white}",     "$extensions": {"web-lab": {"dark": "{color.gray.950}"}}},
      "foreground":          {"$value": "{color.gray.900}",  "$extensions": {"web-lab": {"dark": "{color.gray.50}"}}},
      "muted":               {"$value": "{color.gray.100}",  "$extensions": {"web-lab": {"dark": "{color.gray.900}"}}},
      "muted-foreground":    {"$value": "{color.gray.600}",  "$extensions": {"web-lab": {"dark": "{color.gray.400}"}}},
      "card":                {"$value": "{color.white}",     "$extensions": {"web-lab": {"dark": "{color.gray.900}"}}},
      "border":              {"$value": "{color.gray.200}",  "$extensions": {"web-lab": {"dark": "{color.gray.800}"}}},
      "accent":              {"$value": "{color.brand.600}", "$extensions": {"web-lab": {"dark": "{color.brand.400}"}}},
      "accent-foreground":   {"$value": "{color.white}",     "$extensions": {"web-lab": {"dark": "{color.gray.950}"}}},
      "primary":             {"$value": "{semantic.color.accent}", "$description": "alias para shadcn; la marca es accent"},
      "primary-foreground":  {"$value": "{semantic.color.accent-foreground}", "$description": "alias para shadcn"},
      "danger":              {"$value": "{color.red.600}",   "$extensions": {"web-lab": {"dark": "{color.red.300}"}}},
      "success":             {"$value": "{color.green.600}", "$extensions": {"web-lab": {"dark": "{color.green.300}"}}},
      "warning":             {"$value": "{color.amber.700}", "$extensions": {"web-lab": {"dark": "{color.amber.300}"}}},
      "ring":                {"$value": "{color.brand.600}", "$extensions": {"web-lab": {"dark": "{color.brand.300}"}}}
    },
    "radius": { "$type": "dimension", "control": {"$value": "{radius.md}"}, "surface": {"$value": "{radius.lg}"} },
    "duration": { "$type": "duration", "ui": {"$value": "{duration.normal}"} },
    "ease": { "$type": "cubicBezier", "ui": {"$value": "{ease.out}"} }
  },

  "component": {
    "$description": "Solo cuando un componente se aparta del semántico. Referencian semantic.*",
    "button": { "$type": "dimension", "height": {"$value": "{spacing.10}"}, "padding-x": {"$value": "{spacing.4}"} },
    "input":  { "$type": "dimension", "height": {"$value": "{spacing.10}"} }
  },

  "$extensions": {
    "web-lab": {
      "$description": "Pares texto sobre fondo a verificar en claro y oscuro. 4.5 texto normal, 3 texto grande, iconos y foco. Los bordes decorativos no tienen requisito WCAG; 1.2 solo garantiza que se distingan. Si el borde es la única señal de un control (input sin fondo ni etiqueta), sube ese par a 3.",
      "contrast": [
        {"fg": "semantic.color.foreground",         "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.muted-foreground",   "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.foreground",         "bg": "semantic.color.muted",      "min": 4.5},
        {"fg": "semantic.color.foreground",         "bg": "semantic.color.card",       "min": 4.5},
        {"fg": "semantic.color.accent-foreground",  "bg": "semantic.color.accent",     "min": 4.5},
        {"fg": "semantic.color.accent",             "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.danger",             "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.success",            "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.warning",            "bg": "semantic.color.background", "min": 4.5},
        {"fg": "semantic.color.border",             "bg": "semantic.color.background", "min": 1.2},
        {"fg": "semantic.color.ring",               "bg": "semantic.color.background", "min": 3}
      ]
    }
  }
}

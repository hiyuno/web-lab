  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": "-0.02em"
    },
    "normal": {
      "$value": "0em"
    },
    "wide": {
      "$value": "0.04em"
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "display": {
      "$value": [
        "Space Grotesk",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "JetBrains Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px"
    },
    "sm": {
      "$value": "8px"
    },
    "md": {
      "$value": "16px"
    },
    "lg": {
      "$value": "24px"
    },
    "xl": {
      "$value": "32px"
    },
    "full": {
      "$value": "9999px"
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px 0 oklch(0 0 0 / 0.05)"
    },
    "md": {
      "$value": "0 4px 6px -1px oklch(0 0 0 / 0.08), 0 2px 4px -2px oklch(0 0 0 / 0.06)"
    },
    "lg": {
      "$value": "0 10px 15px -3px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.08)"
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "in-out": {
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "spring": {
      "$value": "linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001)"
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "188ms"
    },
    "normal": {
      "$value": "250ms"
    },
    "slow": {
      "$value": "375ms"
    },
    "page": {
      "$value": "500ms"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "48rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  },
  "semantic": {
    "$description": "Decisions. Aliases to primitives only. Dark mode in $extensions.web-lab.dark.",
    "color": {
      "$type": "color",
      "background": {
        "$value": "{color.white}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.950}"
          }
        }
      },
      "foreground": {
        "$value": "{color.gray.900}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.50}"
          }
        }
      },
      "muted": {
        "$value": "{color.gray.100}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.900}"
          }
        }
      },
      "muted-foreground": {
        "$value": "{color.gray.600}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.400}"
          }
        }
      },
      "card": {
        "$value": "{color.white}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.900}"
          }
        }
      },
      "border": {
        "$value": "{color.gray.200}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.800}"
          }
        }
      },
      "accent": {
        "$value": "{color.brand.600}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.brand.400}"
          }
        }
      },
      "accent-foreground": {
        "$value": "{color.white}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.gray.950}"
          }
        }
      },
      "danger": {
        "$value": "{color.red.600}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.red.300}"
          }
        }
      },
      "success": {
        "$value": "{color.green.700}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.green.300}"
          }
        }
      },
      "warning": {
        "$value": "{color.amber.700}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.amber.300}"
          }
        }
      },
      "ring": {
        "$value": "{color.brand.600}",
        "$extensions": {
          "web-lab": {
            "dark": "{color.brand.300}"
          }
        }
      },
      "primary": {
        "$value": "{semantic.color.accent}",
        "$description": "alias for shadcn; the brand is accent"
      },
      "primary-foreground": {
        "$value": "{semantic.color.accent-foreground}",
        "$description": "alias for shadcn"
      }
    },
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": "{radius.md}"
      },
      "surface": {
        "$value": "{radius.lg}"
      }
    },
    "duration": {
      "$type": "duration",
      "ui": {
        "$value": "{duration.normal}"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "ui": {
        "$value": "{ease.out}"
      }
    }
  },
  "component": {
    "$description": "Only when a component deviates from the semantic tier. Reference semantic.*",
    "button": {
      "$type": "dimension",
      "height": {
        "$value": "{spacing.10}"
      },
      "padding-x": {
        "$value": "{spacing.4}"
      }
    },
    "input": {
      "$type": "dimension",
      "height": {
        "$value": "{spacing.10}"
      }
    },
    "corner-shape": {
      "$type": "string",
      "$value": "squircle",
      "$description": "CSS corner-shape where supported; radius is the fallback."
    },
    "border-width": {
      "$type": "dimension",
      "$value": "0px"
    }
  },
  "$extensions": {
    "web-lab": {
      "$description": "Text-on-background pairs verified in light and dark. 4.5 normal text, 3 large text, icons and focus. Decorative borders have no WCAG requirement.",
      "contrast": [
        {
          "fg": "semantic.color.foreground",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.muted-foreground",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.foreground",
          "bg": "semantic.color.muted",
          "min": 4.5
        },
        {
          "fg": "semantic.color.foreground",
          "bg": "semantic.color.card",
          "min": 4.5
        },
        {
          "fg": "semantic.color.accent-foreground",
          "bg": "semantic.color.accent",
          "min": 4.5
        },
        {
          "fg": "semantic.color.accent",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.danger",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.success",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.warning",
          "bg": "semantic.color.background",
          "min": 4.5
        },
        {
          "fg": "semantic.color.ring",
          "bg": "semantic.color.background",
          "min": 3
        },
        {
          "fg": "semantic.color.border",
          "bg": "semantic.color.background",
          "min": 1.2
        }
      ],
      "lab": {
        "accent": "#db2777",
        "pin": false,
        "tint": 0.012,
        "radius": 16,
        "corner": "squircle",
        "shadow": "soft",
        "border": 0,
        "font": "Space Grotesk / IBM Plex Sans",
        "ratio": 1.25,
        "base": 16,
        "leading": 1.5,
        "space": 5,
        "width": 72,
        "duration": 250,
        "ease": "out",
        "copy": {
          "brand": "Casa Yoga",
          "title": "Yoga classes that fit around your week",
          "lede": "Small groups, real teachers.",
          "cta": "Book a class",
          "cta2": "See the schedule"
        },
        "name": "Template A"
      }
    }
  }
}
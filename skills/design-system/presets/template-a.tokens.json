      "$value": "1.563rem"
    },
    "2xl": {
      "$value": "1.953rem"
    },
    "3xl": {
      "$value": "2.441rem"
    },
    "4xl": {
      "$value": "3.052rem"
    },
    "5xl": {
      "$value": "3.815rem"
    },
    "6xl": {
      "$value": "4.768rem"
    }

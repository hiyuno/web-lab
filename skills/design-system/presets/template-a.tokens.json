      "$value": "10rem"
    },
    "$type": "dimension",
    "$description": "Base 5. Tailwind generates p-*, m-*, gap-* from these keys."
  },
  "text": {
    "$type": "dimension",
    "$description": "Type scale, base 16px, ratio 1.25. Tailwind generates text-*.",
    "xs": {
      "$value": "0.64rem"
    },
    "sm": {
      "$value": "0.8rem"
    },
    "base": {
      "$value": "1rem"
    },
    "lg": {
      "$value": "1.25rem"
    },

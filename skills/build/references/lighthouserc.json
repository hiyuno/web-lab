{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 2500}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.1}],
        "total-blocking-time": ["error", {"maxNumericValue": 200}],
        "interactive": ["warn", {"maxNumericValue": 3800}],
        "resource-summary:document:size": ["error", {"maxNumericValue": 51200}],
        "resource-summary:stylesheet:size": ["error", {"maxNumericValue": 61440}],
        "resource-summary:script:size": ["error", {"maxNumericValue": 153600}],
        "resource-summary:font:size": ["error", {"maxNumericValue": 81920}],
        "resource-summary:image:size": ["warn", {"maxNumericValue": 204800}],
        "resource-summary:third-party:count": ["warn", {"maxNumericValue": 5}],
        "uses-responsive-images": "warn",
        "modern-image-formats": "warn",
        "unused-javascript": "warn",
        "render-blocking-resources": "warn",
        "font-display": "error",
        "color-contrast": "error",
        "tap-targets": "error",
        "is-crawlable": "error",
        "csp-xss": "warn"
      }
    },
    "upload": {"target": "temporary-public-storage"}
  }
}
